{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supramark.dev/schemas/markdown-conformance-cases-v1.json",
  "title": "Supramark imported Markdown case collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "profile", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "profile": {
      "type": "string",
      "enum": ["commonmark", "gfm", "supramark"]
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "case.schema.json" }
    }
  }
}
